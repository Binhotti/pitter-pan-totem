# Arquivo: .env.example
# Modelo de variáveis de ambiente do sistema Pitter Pan.
# Copie este arquivo para ".env" e preencha com os valores reais do
# ambiente local (XAMPP). O ".env" real NUNCA deve ser versionado.

APP_NOME="Pitter Pan"
APP_AMBIENTE=desenvolvimento
APP_URL=http://localhost/pitterpan-sistema/public

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=pitterpan
DB_USERNAME=root
DB_PASSWORD=

MAIL_HOST=
MAIL_PORT=
MAIL_FROM=
